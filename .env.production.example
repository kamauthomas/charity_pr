# Cindy Apparel — production demo environment
# Copy to .env on the server and fill in real values. NEVER commit the filled file.

APP_NAME="Cindy Apparel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo.example.co.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# SQLite is fine for a static-catalog demo. Switch to mysql/pgsql
# when orders and inventory become real tables.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cindy
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="orders@cindyapparel.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

# --- M-Pesa Daraja (checkout is a placeholder until these exist) ---
